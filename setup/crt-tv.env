# crt-tv configuration — read by the weather-kiosk service and the `tv` command.
# Installed to /etc/crt-tv/crt-tv.env (install.sh won't overwrite your edits).

# URL the kiosk shows at boot. Paste a ws4kp permalink URL (host changed to
# 127.0.0.1:8080) to bake in display settings. No quoting needed — '&' and
# '?' are fine here. The location in a permalink is ignored; KIOSK_LOCATION
# below decides that.
KIOSK_URL=http://127.0.0.1:8080/

# Where the weather is: a ws4kp search string — a ZIP code, or "City, ST".
# Forced on every kiosk launch, so the TV can't drift to another city via a
# stale permalink or a browser profile. Default: San Francisco, 94102.
#KIOSK_LOCATION=94102
# Optional coordinates for it, percent-encoded JSON, which skip ws4kp's
# geocoder lookup at startup (the default 94102 has these built in):
#KIOSK_LATLON=%7B%22lat%22%3A37.7815%2C%22lon%22%3A-122.4167%7D

# Overscan compensation for the kiosk channels (weather, oscilloscope): the
# fraction of the raster the CRT actually shows, per axis, plus a centring
# nudge in raster pixels. The page is scaled to this and centred, so nothing
# — the WeatherStar's bottom scroll least of all — falls off the edge, and
# the monitor's UNDERSCAN button stays off. Default 0.943 both axes: the
# PVM-9045Q spec puts normal scan at 6% overscan of the effective screen
# (1/1.06 ≈ 0.943). Real tubes drift — run `tv pattern` for a calibration
# grid and tune until its green box kisses all four visible edges.
#KIOSK_FIT=0.943        # both axes at once
#KIOSK_FIT_X=0.943      # or per axis
#KIOSK_FIT_Y=0.943
#KIOSK_SHIFT_X=0        # raster px; positive moves the picture right
#KIOSK_SHIFT_Y=0        # raster px; positive moves the picture down

# Background music (ws4kp's built-in tracks) over the TRRS audio pins.
# Set to off to silence the weather channel.
#KIOSK_MUSIC=on

# Extra Chromium flags for the kiosk, space-separated (optional).
#KIOSK_FLAGS=

# `tv play <name>` looks here when <name> isn't an absolute/relative path.
# The web remote's video library also lists this directory.
MEDIA_DIR=/srv/media

# Port for the web remote (http://<pi>:8090/).
CRT_REMOTE_PORT=8090

# HTTPS for the web remote: set a hostname you own (e.g. tv.example.com)
# and put a Cloudflare API token in /etc/crt-tv/cloudflare.ini (see
# setup/cloudflare.ini.example) — install.sh then gets a Let's Encrypt
# certificate via the DNS-01 challenge (works for LAN-only hosts; the
# hostname can live on your router's local DNS) and serves the remote on
# :443 through nginx. See README "HTTPS for the web remote".
#HTTPS_DOMAIN=

# Optional: Let's Encrypt sends expiry warnings here. Renewal is
# automatic either way (certbot's systemd timer).
#LETSENCRYPT_EMAIL=

# Extra lip-sync shift while casting to AirPlay, in ms (positive delays
# video). Default 0: PipeWire reports the AirPlay buffer and mpv
# compensates on its own — only set this if mouths still drift.
#AIRPLAY_LATENCY_MS=0

# Same, for the OwnTone "(with titles)" outputs — that path buffers ~2s
# and can't report it, so the player shifts video by this much.
#OWNTONE_LATENCY_MS=2000

# How 16:9 videos fit the 4:3 screen: 1.0 = zoom to fill, sides cropped
# (broadcast center-cut, the default); 0 = letterbox with bars.
#CRT_PANSCAN=1.0
